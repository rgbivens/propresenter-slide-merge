# Slide Merge
Options -Indexes
DirectoryIndex index.html

# Keep settings and setup files off the web.
<FilesMatch "^(config\.php|lib\.php|schema\.sql|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
